{
    "name": "PX4 + ROS2 Humble (22.04)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--privileged",
        "--network=host"
    ],
    "postCreateCommand": "git config --global --add safe.directory '*' && echo 'Environment ready. Source ROS with: source /opt/ros/humble/setup.bash'",
    "customizations": {
        "vscode": {
            "extensions": [
                "Ranch-Hand-Robotics.rde-ros-2",
                "Ranch-Hand-Robotics.rde-urdf",
                "ms-python.python",
                "ms-vscode.cpptools"
            ]
        }
    }
}